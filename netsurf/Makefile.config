# NetSurf build configuration for the Nintendo Switch port.

# No OpenSSL port for Switch; TLS comes from curl+mbedtls.
override NETSURF_USE_OPENSSL := NO



# Switch: real GNU libiconv symbol names (newlib has no built-in iconv).
# Native glibc: iconv lives in libc, use the plug.
ifeq ($(HOST),aarch64-none-elf)
override NETSURF_USE_LIBICONV_PLUG := NO
else
override NETSURF_USE_LIBICONV_PLUG := YES
endif

# Resources live in the NRO romfs (; is fixed to : at runtime)
override NETSURF_FRAMEBUFFER_RESOURCES := romfs;/res
override NETSURF_FB_RESPATH := romfs;/res:./frontends/framebuffer/res

# Diagnostic logging for hardware bring-up
override NETSURF_LOG_LEVEL := INFO
override NETSURF_BUILTIN_LOG_FILTER := "level:INFO"

# Freetype fonts from romfs (native fallback: system TTF dir)
override NETSURF_FB_FONTLIB := freetype
override NETSURF_FB_FONTPATH := romfs;/res/fonts:/usr/share/fonts/TTF
override NETSURF_FB_FONT_CURSIVE := DejaVuSans.ttf
override NETSURF_FB_FONT_FANTASY := DejaVuSans.ttf

# QuickJS-ng is the JS engine for this port (ES2023 + the hand-written
# core DOM bindings in content/handlers/javascript/quickjs). Duktape is
# no longer built; set this to NO only to fall back to it for comparison.
NETSURF_USE_QUICKJS ?= YES
